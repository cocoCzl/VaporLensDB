# Live integration test settings.
# Copy this file to .env only for local manual testing. Do not commit .env.

TEST_PG_JDBC_URL='jdbc:postgresql://<postgres-host>:5432/<postgres-database>'
TEST_PG_USER='<postgres-user>'
TEST_PG_PASSWORD='<postgres-password>'
TEST_PG_DATABASE='<postgres-database>'
TEST_PG_JDBC_DRIVER_PATH='/absolute/path/to/postgresql.jar'
VAPORLENSDB_TEST_POSTGRES_URL='host=<postgres-host> port=5432 dbname=<admin-database> user=<postgres-user> password=<postgres-password>'

TEST_MYSQL_JDBC_URL='jdbc:mysql://<mysql-host>:3306/<mysql-database>'
TEST_MYSQL_USER='<mysql-user>'
TEST_MYSQL_PASSWORD='<mysql-password>'
TEST_MYSQL_DATABASE='<mysql-database>'
TEST_MYSQL_JDBC_DRIVER_PATH='/absolute/path/to/mysql-connector-j.jar'
VAPORLENSDB_TEST_MYSQL_URL='mysql://<mysql-user>:<mysql-password>@<mysql-host>:3306/<admin-database>'

TEST_ORACLE_JDBC_URL='jdbc:oracle:thin:@//<oracle-host>:1521/<oracle-service>'
TEST_ORACLE_USER='<oracle-user>'
TEST_ORACLE_PASSWORD='<oracle-password>'
TEST_ORACLE_JDBC_DRIVER_PATH='/absolute/path/to/ojdbc11.jar'
